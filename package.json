{
  "name": "libretto",
  "version": "0.0.0",
  "description": "Spec-driven end-to-end testing: markdown specs in, Playwright tests out, AI triage when they fail.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.18" },
  "bin": { "libretto": "./dist/cli/main.js" },
  "exports": {
    ".": "./dist/index.js",
    "./test": "./dist/test/index.js",
    "./reporter": "./dist/run/reporter.js",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.83",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.50",
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "@github/copilot-sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": { "optional": true },
    "@github/copilot-sdk": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
